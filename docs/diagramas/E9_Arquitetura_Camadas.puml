@startuml E9_Arquitetura_Camadas
skinparam shadowing false
skinparam packageStyle rectangle
skinparam componentStyle rectangle

title Arquitetura em Camadas Estritas (Java 17 + JDBC + MySQL 8) – HotelFlow [Atende RN01 a RN20]

package "br.senac.hotelflow" {

    package "view (Apresentação Desktop Swing)" #EFF6FF {
        [HotelFlowApp]
        [Telas / Painéis por Perfil\n(Recepcionista | Gerente | Camareira)] as UI
    }

    package "service (Orquestração e Casos de Uso)" #F0FDF4 {
        [AutenticacaoService]
        [CadastroService]
        [ReservaService]
        [HospedagemService]
        [CheckOutService]
        [GeradorReciboService]
        [RelatorioOcupacaoService]

        package "service.notificacao" {
            interface "EmailService" as IEmail
            [SmtpEmailService]
            [ConsoleEmailService]
        }
    }

    package "model (Domínio Rico - Classes POO)" #FFFBEB {
        [Usuario / Hospede / Quarto / CategoriaQuarto]
        [Reserva / ConsumoFrigobar / ServicoQuarto]
        [Fatura / CupomDesconto / Pagamento]
        package "model.enums" {
            [PerfilUsuario | StatusReserva | StatusOcupacao\nStatusLimpeza | StatusFatura | FormaPagamento]
        }
    }

    package "dao (Persistência Relacional JDBC)" #FAF5FF {
        [UsuarioDAO / HospedeDAO / QuartoDAO / CategoriaQuartoDAO]
        [ReservaDAO / ConsumoFrigobarDAO / ServicoQuartoDAO]
        [FaturaDAO / PagamentoDAO / CupomDescontoDAO]
    }

    package "config (Infraestrutura JDBC)" #F8FAFC {
        [ConnectionFactory\n<<Singleton>>] as ConnFactory
    }

    package "exception (Exceções Transversais)" #FEF2F2 {
        [HotelFlowException\nAutenticacaoException | AutorizacaoException\nRegraNegocioException | PersistenciaException] as Ex
    }
}

database "MySQL 8.0+ (InnoDB)\nSchema: hotelflow" as MySQL #E2E8F0

' Regras de Dependência Unidirecional
UI --> [AutenticacaoService]
UI --> [ReservaService]
UI --> [CheckOutService]

[SmtpEmailService] .up.|> IEmail
[ConsoleEmailService] .up.|> IEmail
[SmtpEmailService] --> [ConsoleEmailService] : fallback offline >
[ReservaService] --> IEmail : dispara RN08 >

[ReservaService] --> [Reserva / ConsumoFrigobar / ServicoQuarto]
[CheckOutService] --> [Fatura / CupomDesconto / Pagamento]
[CheckOutService] --> [GeradorReciboService] : formata RN18 >

[ReservaService] --> [ReservaDAO / ConsumoFrigobarDAO / ServicoQuartoDAO]
[CheckOutService] --> [FaturaDAO / PagamentoDAO / CupomDescontoDAO]

[ReservaDAO / ConsumoFrigobarDAO / ServicoQuartoDAO] --> [Reserva / ConsumoFrigobar / ServicoQuarto] : hidrata / persiste >
[FaturaDAO / PagamentoDAO / CupomDescontoDAO] --> [Fatura / CupomDesconto / Pagamento]

[ReservaDAO / ConsumoFrigobarDAO / ServicoQuartoDAO] --> ConnFactory
[FaturaDAO / PagamentoDAO / CupomDescontoDAO] --> ConnFactory
[ReservaService] ..> ConnFactory : transação + lock FOR UPDATE (RN06, RN09) >
[CheckOutService] ..> ConnFactory : transação + lock FOR UPDATE (RN15..RN17) >

ConnFactory --> MySQL : DriverManager / Connector-J 8.4

@enduml
